{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaxin-lin/sidepaw/docs/contracts/persona.schema.json",
  "title": "sidepaw persona",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "callsUser": { "type": "string", "maxLength": 40 },
    "species": { "type": "string", "maxLength": 40 },
    "sliders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "talkative": { "$ref": "#/$defs/unit" },
        "sharp": { "$ref": "#/$defs/unit" },
        "proactive": { "$ref": "#/$defs/unit" },
        "serious": { "$ref": "#/$defs/unit" },
        "confident": { "$ref": "#/$defs/unit" },
        "clingy": { "$ref": "#/$defs/unit" }
      }
    },
    "strengths": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 30 } },
    "flaws": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 30 } },
    "catchphrases": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
    "avoid": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
